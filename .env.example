# ============================================================
# VendorFlow Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=VendorFlow
NEXT_PUBLIC_APP_VERSION=1.0.0

# ── Supabase (REQUIRED) ───────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Server-side only — NEVER expose to the client
# Used by: lib/supabase/admin.ts (invite emails, service-level user management)
# Found in: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── Email — Brevo / Sendinblue (REQUIRED for invitations) ────────────────────
# Required for: employee invitation emails, procurement notifications
# Get key at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=<your-brevo-api-key>
BREVO_SENDER_EMAIL=noreply@yourcompany.com

# ── AI — OpenAI (optional) ────────────────────────────────────────────────────
# Required only if the AI Assistant feature is used
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=<your-openai-api-key>

# ── AI — Google Gemini (optional, alternative to OpenAI) ─────────────────────
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<your-gemini-api-key>

# ── Payments — Razorpay (optional) ───────────────────────────────────────────
# Required if Razorpay payment gateway is enabled
NEXT_PUBLIC_RAZORPAY_KEY_ID=<your-razorpay-key-id>

# ── Error monitoring — Sentry (optional) ─────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
