# ============================================================
# VendorFlow Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=VendorFlow
NEXT_PUBLIC_APP_VERSION=1.0.0

# Supabase (Phase 3+)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (server-side ONLY — never expose to the client)
# Found in: Supabase Dashboard → Project → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — used by the AI Assistant (/ai page and floating chat button)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini — alternative AI provider (free tier available)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Brevo (formerly Sendinblue) — transactional email for notifications
# Get your API key at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@yourcompany.com

# Razorpay (Phase 22+)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Sentry (Phase 32+)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
